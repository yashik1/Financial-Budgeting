# ---------------------------------------------------------------------------
# FinBud environment configuration
# Copy this file to `.env` and adjust as needed.  `npm run setup` reads `.env`.
# ---------------------------------------------------------------------------

# Database
# Local/dev default is SQLite (zero-setup, runs anywhere):
DATABASE_URL="file:./dev.db"
#
# For production, switch prisma/schema.prisma `provider` to "postgresql" and use:
# DATABASE_URL="postgresql://finbud:finbud@localhost:5432/finbud?schema=public"
# (a ready-to-run Postgres is provided in docker-compose.yml)

# Auth: secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production"

# ---------------------------------------------------------------------------
# Aggregation providers (OFF by default in v1 — demo + CSV import need no keys).
# Fill these in later to enable real bank/broker connectivity.
# ---------------------------------------------------------------------------
# Which provider powers "connect an account": demo | plaid
AGGREGATION_PROVIDER="demo"

# Plaid (banks/cards/transactions) — https://dashboard.plaid.com
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# SnapTrade (brokerages/crypto) — https://snaptrade.com
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
