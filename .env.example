# ---------------------------------------------------------------------------
# FinBud environment configuration
# Copy this file to `.env` and adjust as needed.  `npm run setup` reads `.env`.
# ---------------------------------------------------------------------------

# Database (Postgres)
# Local dev: `docker compose up -d db` starts a Postgres matching this URL.
# In production always require TLS and connect as a least-privilege role that
# owns only this schema (no SUPERUSER/CREATEDB):
#   DATABASE_URL="postgresql://finbud_app:...@host:5432/finbud?schema=public&sslmode=require"
DATABASE_URL="postgresql://finbud:finbud@localhost:5432/finbud?schema=public"
#
# On Railway: add a Postgres plugin, then reference its variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Only if DATABASE_URL is a *pooled* URL (PgBouncer/Neon pooler): also set a
# direct connection for migrations and add `directUrl = env("DIRECT_URL")` to
# prisma/schema.prisma. Not needed for Railway's default Postgres.
# DIRECT_URL="postgresql://.../finbud"

# Auth: secret used to sign session cookies. REQUIRED — at least 32 characters.
# Never commit a real value, and never reuse one across environments: anyone
# holding it can forge a session cookie for any user. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Encryption key for secrets at rest (Plaid/SnapTrade credentials). 64 hex chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# AI insights & chat (optional). Leave blank to keep the AI Coach disabled.
# Get a key at https://console.anthropic.com  (uses model claude-opus-4-8)
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Aggregation providers (OFF by default in v1 — demo + CSV import need no keys).
# Fill these in later to enable real bank/broker connectivity.
# ---------------------------------------------------------------------------
# Which provider powers "connect an account": demo | plaid
AGGREGATION_PROVIDER="demo"

# Plaid (banks/cards/transactions) — https://dashboard.plaid.com
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# SnapTrade (brokerages/crypto) — https://snaptrade.com
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
