// FinBud data model.
//
// Postgres for dev and prod. Local dev uses the docker-compose Postgres
// (`docker compose up -d db`); production points DATABASE_URL at a managed
// Postgres (e.g. Railway). The schema avoids Prisma enums and Json and stores
// all money as integer minor units (cents), so it stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // If you put a *pooled* URL in DATABASE_URL (e.g. PgBouncer/Neon pooler), add a
  // direct connection for migrations:  directUrl = env("DIRECT_URL")
  // Railway's default Postgres is a direct connection, so this isn't needed there.
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // null for the seeded demo user (magic "Try the demo" login)
  isDemo       Boolean  @default(false)
  currency     String   @default("USD") // ISO 4217 display currency
  createdAt    DateTime @default(now())

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  accounts     Account[]
  transactions Transaction[]
  categories   Category[]
  budgetLines  BudgetLine[]
  goals        Goal[]
  rules        Rule[]
  achievements Achievement[]
  stats        UserStats?
  plaidItems   PlaidItem[]
  snapTrade    SnapTradeConnection?
}

// A shared household groups members who see each other's (non-private) money.
model Household {
  id          String            @id @default(cuid())
  name        String
  createdById String?
  createdAt   DateTime          @default(now())
  members     User[]
  invites     HouseholdInvite[]
}

// Email invitation to join a household. Accepted by the invitee when logged in.
model HouseholdInvite {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String // invitee email, lowercased
  invitedById String
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([householdId])
}

model Category {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  group    String // "Income" | "Essentials" | "Lifestyle" | "Financial" | "Other"
  icon     String  @default("💸") // emoji
  color    String  @default("#635BFF")
  isIncome Boolean @default(false)
  sort     Int     @default(0)

  // Optional parent for subcategories (e.g. Transportation → Oil change, Tires).
  parentId String?
  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children Category[] @relation("Subcategories")

  transactions Transaction[]
  budgetLines  BudgetLine[]
  rules        Rule[]

  @@unique([userId, name])
  @@index([userId])
  @@index([parentId])
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String // "checking" | "savings" | "credit" | "investment" | "cash" | "loan"
  institution   String
  mask          String   @default("0000") // last 4
  balanceCents  Int      @default(0)
  currency      String   @default("USD")
  isAsset       Boolean  @default(true) // false for credit/loan (liabilities)
  shared        Boolean  @default(true) // visible to the household? false = private
  color         String   @default("#635BFF")
  providerId    String   @default("demo") // demo | plaid | snaptrade | manual | csv
  externalId    String? // provider's account id (for real aggregation later)
  createdAt     DateTime @default(now())

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime
  // Signed cents: negative = outflow (spending), positive = inflow (income).
  amountCents    Int
  merchant       String
  rawDescription String   @default("")
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  pending        Boolean  @default(false)
  isTransfer     Boolean  @default(false)
  notes          String?
  tags           String[] @default([]) // free-form labels for filtering
  // Splits: a child references its parent; parent keeps the original amount.
  splitParentId  String?
  splitParent    Transaction?  @relation("Splits", fields: [splitParentId], references: [id])
  splits         Transaction[] @relation("Splits")
  // Provider transaction id, used to de-duplicate incremental syncs.
  externalId     String?
  createdAt      DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([externalId])
}

// Envelope / zero-based budgeting: one limit per category per month.
model BudgetLine {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String // "YYYY-MM"
  limitCents Int

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model Goal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  emoji      String    @default("🎯")
  targetCents Int
  savedCents  Int      @default(0)
  color      String    @default("#16A374")
  shared     Boolean   @default(true) // visible to the household? false = private
  deadline   DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Auto-categorization rule: if `matcher` appears in the description, apply category.
model Rule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matcher    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Persisted gamification unlocks. Definitions live in code (lib/gamification).
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model UserStats {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points         Int    @default(0)
  level          Int    @default(1)
  savingsStreak  Int    @default(0) // consecutive on-budget months
  longestStreak  Int    @default(0)
}

// ---------------------------------------------------------------------------
// Real bank/broker connectivity (sandbox-ready). Populated only when provider
// keys are configured; the app runs on demo + CSV without these.
// ---------------------------------------------------------------------------

// One Plaid "Item" = one connected bank login (may hold several accounts).
model PlaidItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String   @unique
  // NOTE: store encrypted at rest in production. Plaintext here for sandbox.
  accessToken String
  institution String   @default("Bank")
  cursor      String? // transactionsSync cursor for incremental pulls
  createdAt   DateTime @default(now())

  @@index([userId])
}

// SnapTrade registers a user and returns a userSecret used on every call.
model SnapTradeConnection {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapUserId String
  userSecret String // treat as a credential — encrypt at rest in production
  createdAt  DateTime @default(now())
}
